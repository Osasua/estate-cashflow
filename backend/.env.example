DATABASE_URL=postgres://postgres:postgres@localhost:5432/estate_cashflow
JWT_SECRET=change-me-in-production
PORT=4000
# Public frontend origin(s). Comma-separated list: the FIRST entry is the
# canonical origin used in emails and Paystack callbacks; ALL entries are
# accepted by CORS so a domain migration can overlap safely.
# Production: FRONTEND_URL=https://ferranocourt.estate
FRONTEND_URL=http://localhost:5173
# Payment gateways (Phase 2 wiring)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Ferrano Gate Access — the gatehouse phone that receives a WhatsApp alert
# per issued visitor code. Needs the Twilio WhatsApp credentials below.
GATE_WHATSAPP_NUMBER=+2348000000000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
